# POAM Tracker Environment Configuration
# Copy this file to .env and customize for your deployment

# REQUIRED: Change this to a strong random string in production
SECRET_KEY=change-me-to-a-secure-random-string

# Default admin credentials (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: custom database path inside container
# DATABASE_URL=sqlite:///app/data/poam.db
